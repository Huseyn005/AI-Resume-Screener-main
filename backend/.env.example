ALLOWED_ORIGINS=https://pushcv.vercel.app,https://statcv.vercel.app,https://pullcv.vercel.app,https://taphire.vercel.app,https://dragcv.vercel.app,http://localhost:5173,http://localhost:8080
ALLOWED_ORIGIN_REGEX=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FINETUNED_REPO=
FINETUNED_REVISION=
HF_TOKEN=
DEBUG_ENDPOINTS=0
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=20
MAX_REQUEST_BYTES=62914560
MAX_FILES=30
MAX_CONCURRENT_ANALYSES=2
QUEUE_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=20
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO

# Train locally, then upload the complete artifact folder to a private Hub repo:
# hf upload YOUR_USER/resume-screener-model backend\models\finetuned .
# Set FINETUNED_REPO (and optionally FINETUNED_REVISION/HF_TOKEN), then restart
# the Space. Training never runs on the server.
